    "husky": "^9",
    "lint-staged": "^15",
    "tailwindcss": "^4",
    "prettier": "^3",
    "typescript": "^5",
    "vitest": "^3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
